# Copy this file to .env and fill in the values for the provider you want to use.
# The whole system works with ANY ONE of the three provider blocks below.
#
# NOTE: if deploying to Railway (or any host without a local Ollama daemon),
# LLM_PROVIDER must be "groq" or "openai" -- ollama only works when you
# also run `ollama serve` on the same machine (local dev / docker-compose).

# ---- Choose ONE: openai | groq | ollama ----------------------------------
LLM_PROVIDER=ollama

# --- OpenAI (paid, highest quality) ---------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Groq (free tier, hosted Llama 3.x, very fast) --------------------------
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# --- Ollama (fully local, zero cost, requires `ollama serve` running) -----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Embeddings backend: openai | local -----------------------------------
# "local" uses sentence-transformers (all-MiniLM-L6-v2), fully offline.
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Chunking ---------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Retrieval ---------------------------------------------------------------
VECTOR_TOP_K=6
GRAPH_HOPS=2
PAGERANK_DAMPING=0.85
MAX_CONTEXT_CHUNKS=8

# --- Self-correction loop -----------------------------------------------------
MAX_CORRECTION_RETRIES=2
HALLUCINATION_THRESHOLD=0.6
RELEVANCE_THRESHOLD=0.6

# --- Storage -----------------------------------------------------------------
# Local dev: leave as-is. On Railway: mount a Volume at /data and change
# these two to /data/chroma and /data/graph.gpickle so the index persists
# across restarts/redeploys.
CHROMA_PERSIST_DIR=./data/chroma
GRAPH_PERSIST_PATH=./data/graph.gpickle

# --- LangSmith observability (PRD section 2 pillar 2) -------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=graph-augmented-self-rag
LANGCHAIN_API_KEY=
